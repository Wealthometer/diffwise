{
  "name": "diffwise",
  "version": "1.0.0",
  "private": true,
  "description": "An AI pull-request reviewer that comments on the exact lines that changed, and an evaluation suite that measures how often it's right.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "tsx watch --env-file=.env src/main-web.ts",
    "dev:worker": "tsx watch --env-file=.env src/main-worker.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:web": "node dist/main-web.js",
    "start:worker": "node dist/main-worker.js",
    "start:migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "review:local": "tsx src/cli/review-diff.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "pino": "^9.14.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
