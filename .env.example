# Copy to .env. Every variable is described in README.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/diffwise
PUBLIC_URL=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# From your GitHub App's settings page (see README → "Create the GitHub App")
GITHUB_APP_ID=
GITHUB_APP_SLUG=diffwise
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Paste the .pem contents with literal \n for newlines, or use GITHUB_PRIVATE_KEY="$(cat key.pem)"
GITHUB_PRIVATE_KEY=

# Optional. Without it Diffwise runs its built-in checks only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
